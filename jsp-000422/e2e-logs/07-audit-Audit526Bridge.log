def Erdos526.arc : Erdos526.Circle → ℝ → Set Erdos526.Circle :=
fun z length => Metric.ball z (length / 2)
def Erdos526.CoversFrom : (ℕ → ℝ) → Erdos526.Sample → ℕ → Prop :=
fun a ω N => ∀ (x : Erdos526.Circle), ∃ n, N ≤ n ∧ x ∈ Erdos526.arc (ω n) (a n)
def Erdos526.CoversOnce : (ℕ → ℝ) → Erdos526.Sample → Prop :=
fun a ω => Erdos526.CoversFrom a ω 0
def Erdos526.CoversInfinitelyOften : (ℕ → ℝ) → Erdos526.Sample → Prop :=
fun a ω => ∀ (N : ℕ), Erdos526.CoversFrom a ω N
def Erdos526.IsDecreasingRearrangement : (ℕ → ℝ) → (ℕ → ℝ) → Prop :=
fun a b => Antitone b ∧ ∃ e, ∀ (k : ℕ), b k = a ↑(e k)
def JSP422FiniteHead.splice : ℕ → Erdos526.Sample × Erdos526.Sample → Erdos526.Sample :=
fun N p n => if n < N then p.2 n else p.1 n
def JSP422FiniteHead.antipode : Erdos526.Circle → Erdos526.Circle :=
fun z => z + ↑(1 / 2)
